# Пример конфигурации. Скопируйте в .env и поменяйте пароли:
#   cp .env.example .env
# После смены CERT_PASSWORD пересоздайте сертификаты:
#   cd kafka && bash scripts/generate-certs.sh

KAFKA_BOOTSTRAP_SERVERS=kafka-1:29092,kafka-2:29092,kafka-3:29092
KAFKA_COPY_BOOTSTRAP_SERVERS=copy-kafka-1:29092,copy-kafka-2:29092,copy-kafka-3:29092

SHOP_TOPIC_NAME=raw-product-topic
CLIENT_TOPIC_NAME=user-query-topic
BANNED_TOPIC_NAME=banned-product-topic
FILTERED_TOPIC_NAME=filtered-product-topic
ANALYST_TOPIC_NAME=analyst-topic

BANNED_STORE_NAME=banned-products-store

SCHEMA_REGISTRY_URL=http://localhost:8081

# Пароль всех keystore/truststore (kafka/scripts/generate-certs.sh)
CERT_PASSWORD=changeit123

# Пользователь ZooKeeper (SASL DIGEST-MD5), которым подключаются брокеры
ZOOKEEPER_USERNAME=zkadmin
ZOOKEEPER_PASSWORD=zk-secret

# SCRAM-SHA-512 пользователи Kafka (создаются контейнерами kafka-users/copy-kafka-users)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin-secret

SHOP_PRODUCER_USERNAME=shop-producer
SHOP_PRODUCER_PASSWORD=shop-producer-secret

CUSTOMER_PRODUCER_USERNAME=customer-producer
CUSTOMER_PRODUCER_PASSWORD=customer-producer-secret

BAN_PRODUCER_USERNAME=ban-producer
BAN_PRODUCER_PASSWORD=ban-producer-secret

STREAMS_USERNAME=streams
STREAMS_PASSWORD=streams-secret

CONNECT_USERNAME=connect
CONNECT_PASSWORD=connect-secret

MIRROR_MAKER_USERNAME=mirror-maker
MIRROR_MAKER_PASSWORD=mirror-maker-secret

ANALYST_CONSUMER_USERNAME=analyst-consumer
ANALYST_CONSUMER_PASSWORD=analyst-consumer-secret

SCHEMA_REGISTRY_USERNAME=schema-registry
SCHEMA_REGISTRY_PASSWORD=schema-registry-secret

# Используется локальными запусками client-api, в Docker задаётся в compose
ELASTICSEARCH_URL=http://elasticsearch:9200
