{
  "name": "mirror2",
  "connector.class": "org.apache.kafka.connect.mirror.MirrorSourceConnector",
  "source.cluster.alias":"origin",
  "target.cluster.alias":"copy",
  "topics":"user-query-topic,filtered-product-topic",
  "source.cluster.bootstrap.servers":"kafka-1:29092,kafka-2:29092,kafka-3:29092",
  "target.cluster.bootstrap.servers":"copy-kafka-1:29092,copy-kafka-2:29092,copy-kafka-3:29092",
  "offset-syncs.topic.replication.factor":"3",
  "replication.policy.class": "org.apache.kafka.connect.mirror.IdentityReplicationPolicy",
  "refresh.topics.interval.seconds": 10,
  "sync.topic.acls.enabled": false,
  "source.cluster.security.protocol": "SASL_SSL",
  "source.cluster.sasl.mechanism": "SCRAM-SHA-512",
  "source.cluster.sasl.jaas.config": "org.apache.kafka.common.security.scram.ScramLoginModule required username=\"mirror-maker\" password=\"mirror-maker-secret\";",
  "source.cluster.ssl.truststore.location": "/etc/kafka/secrets/mirror-maker.truststore.jks",
  "source.cluster.ssl.truststore.password": "changeit123",
  "source.cluster.ssl.keystore.location": "/etc/kafka/secrets/mirror-maker.keystore.jks",
  "source.cluster.ssl.keystore.password": "changeit123",
  "source.cluster.ssl.key.password": "changeit123",
  "source.cluster.ssl.endpoint.identification.algorithm": "https",
  "target.cluster.security.protocol": "SASL_SSL",
  "target.cluster.sasl.mechanism": "SCRAM-SHA-512",
  "target.cluster.sasl.jaas.config": "org.apache.kafka.common.security.scram.ScramLoginModule required username=\"mirror-maker\" password=\"mirror-maker-secret\";",
  "target.cluster.ssl.truststore.location": "/etc/kafka/secrets/mirror-maker.truststore.jks",
  "target.cluster.ssl.truststore.password": "changeit123",
  "target.cluster.ssl.keystore.location": "/etc/kafka/secrets/mirror-maker.keystore.jks",
  "target.cluster.ssl.keystore.password": "changeit123",
  "target.cluster.ssl.key.password": "changeit123",
  "target.cluster.ssl.endpoint.identification.algorithm": "https"
}